# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/evaluation/output
/evaluation/private
__pycache__/
*.py[cod]
.pytest_cache/

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.key
*.pem
*credentials*
*credential*
*api_key*
*apikey*
*service-account*
.claude/
.superpowers/

# model artifacts
*.pt
*.pth
*.onnx
*.engine
*.ckpt
worker/models/
worker/weights/*
!worker/weights/.gitkeep
!worker/weights/yolov12s_rdd2022.pt

# generated outputs
reports/
outputs/
worker/reports/
worker/outputs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
